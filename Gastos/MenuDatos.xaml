<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gastos.MenuDatos"
             x:Name="thisPage"
             Shell.NavBarIsVisible="False">

    <Grid BackgroundColor="White"
        RowDefinitions="Auto, Auto, 1*"
        VerticalOptions="Fill"
        HorizontalOptions="Fill">
        
        <HorizontalStackLayout Grid.Row="0" VerticalOptions="Center"
            HorizontalOptions="Start">
            <Label Text="Gastos"
                TextColor="Black"
                FontAttributes="Bold"
                FontSize="25"
                Margin="10"/>
        </HorizontalStackLayout>

        <Grid ColumnDefinitions="Auto,*,Auto" Grid.Row="1" Padding="10">
            <Button Text="◀" Clicked="SemanaAnterior_Clicked"
                    BackgroundColor="Transparent" TextColor="Black"/>
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                <Label x:Name="LblSemana"
                    HorizontalTextAlignment="Center"
                    FontSize="16" FontAttributes="Bold" TextColor="Black"/>
                <Label x:Name="LblTotal"
                    HorizontalTextAlignment="Center"
                    FontSize="13" TextColor="#AEAEB2"/>
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="▶" Clicked="SemanaSiguiente_Clicked"
                    BackgroundColor="Transparent" TextColor="Black"/>
        </Grid>

        <Grid RowDefinitions="1*, 70" Grid.Row="2">
            <CollectionView ItemsSource="{Binding ListaGastos}"
                x:Name="ListaGastosCollection"
                Grid.Row="0"
                SelectionMode="Single"
                SelectionChanged="ListaGastosCollection_SelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border StrokeShape="RoundRectangle 30"
                                    BackgroundColor="White"
                                    Padding="10"
                                    Margin="5"
                                    HeightRequest="100"
                                    StrokeThickness="0">
                                    <Border.Shadow>
                                        <Shadow Brush="Black"
                                            Offset="3,3"
                                            Radius="10"
                                            Opacity="0.5"/>
                                    </Border.Shadow>
                                    
                                    <Grid ColumnDefinitions="56, *, Auto, Auto" Padding="12" ColumnSpacing="12">

                                        <Border WidthRequest="46"
                                                HeightRequest="46"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14"
                                                BackgroundColor="#FFF3E0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Label Text="💸"
                                                FontSize="22"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"/>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding descripcion}"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                TextColor="#1D1D1F"
                                                LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding fecha, StringFormat='{0:dddd dd MMM}'}"
                                                FontSize="12"
                                                TextColor="#AEAEB2"/>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2"
                                            Text="{Binding monto, StringFormat='- ${0:N2}'}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="#E53935"
                                            VerticalOptions="Center"/>

                                        <Border StrokeShape="RoundRectangle 30"
                                            StrokeThickness="0"
                                            Margin="10"
                                            Grid.Column="3"
                                            BackgroundColor="White">
                                            <Border.Shadow>
                                                <Shadow Brush="Black"
                                                    Offset="2,2"
                                                    Radius="5"
                                                    Opacity="0.5"/>
                                            </Border.Shadow>
                                                <Button x:Name="BtnEliminarGastos"
                                                    Clicked="BtnEliminarGastos_Clicked"
                                                    BackgroundColor="White"
                                                    Text="🗑️"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
            </CollectionView>

            <Border StrokeShape="RoundRectangle 30"
                BackgroundColor="White"
                WidthRequest="60"
                Margin="5"
                StrokeThickness="0"
                HorizontalOptions="End"
                Grid.Row="1">
                <Border.Shadow>
                    <Shadow Brush="black"
                        Offset="3,3"
                        Radius="10"
                        Opacity="0.5"/>
                </Border.Shadow>
                            
                    <Button x:Name="BtnAgregarGastos"
                        BackgroundColor="White"
                        Text="+"
                        BorderWidth="0"
                        FontSize="20"
                        TextColor="Black"
                        Clicked="BtnAgregarGastos_Clicked"/>

            </Border>
        </Grid>

        <Grid x:Name="Popup"
            IsVisible="False"
            Grid.RowSpan="3"
            Grid.Row="0"
            BackgroundColor="Transparent"
            HorizontalOptions="Center"
            VerticalOptions="Center">
                    
            <Border BackgroundColor="#E6FFFFFF" 
                StrokeThickness="1"
                Stroke="#33FFFFFF"
                StrokeShape="RoundRectangle 24"
                WidthRequest="320"
                Padding="20">

                <Border.Shadow>
                    <Shadow Brush="Black"
                        Offset="0,15"
                        Radius="25"
                        Opacity="0.15"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">

                    <Label Text="Nuevo Gasto"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#1A73E8"
                        HorizontalOptions="Center"/>

                    <BoxView HeightRequest="1" Color="#F0F0F0" Margin="0,0,0,4"/>

                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="1"
                            Stroke="#E0E0E0" BackgroundColor="#F8F8F8" Padding="14,4">
                        <Entry x:Name="txtMonto"
                            Placeholder="Monto"
                            Keyboard="Numeric"
                            TextColor="#1D1D1F"
                            PlaceholderColor="#AEAEB2"/>
                    </Border>

                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="1"
                            Stroke="#E0E0E0" BackgroundColor="#F8F8F8" Padding="14,4">
                        <Entry x:Name="txtDescripcion"
                            Placeholder="Descripción"
                            TextColor="#1D1D1F"
                            PlaceholderColor="#AEAEB2"/>
                    </Border>

                    <Grid ColumnDefinitions="1*, 1*" ColumnSpacing="12" Margin="0,10,0,0">
                                
                        <Button Text="Cancelar" 
                            x:Name="BtnCerrarPopup"
                            BackgroundColor="#1AFF3B30" 
                            TextColor="#FF3B30"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="45"
                            Grid.Column="0"
                            Clicked="BtnCerrarPopup_Clicked"/>

                        <Button Text="Guardar" 
                            x:Name="BtnGuardarPopup"
                            BackgroundColor="#007AFF"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="45"
                            Grid.Column="1"
                            Clicked="BtnGuardarPopup_Clicked"/>

                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>